{
    "name": "infrangible/m2-bundle-option",
    "description": "Lets you link custom options of a bundle product to individual bundle options, so the shopper's choice is attached to the item selected in that bundle option.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Bundle products",
        "Product options",
        "custom options per bundle option",
        "bundle custom options",
        "link custom options to bundle items"
    ],
    "homepage": "https://www.infrangible.dev/modules/bundle-option",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.6",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-bundle": "~101.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-sales": "~103.0.0",
        "magento/module-ui": "~101.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\BundleOption\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
